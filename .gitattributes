#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Normalize line endings to LF in the repository by default.
* text=auto eol=lf

# Linux start script should use lf
/gradlew text eol=lf

# These are Windows script files and should use crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files should be left untouched
*.jar binary
*.webp binary
*.png binary
*.jpg binary
*.keystore binary
*.jks binary
